# Copy to .env and fill in. Never commit .env.
# Persistent vector store (docker compose up -d qdrant)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Embeddings: auto (Azure if configured, else local), azure or local
REPOLENS_EMBEDDINGS=auto
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
